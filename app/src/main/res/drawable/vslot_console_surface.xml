<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:endColor="#FA05080D"
                android:startColor="#F51A2330" />
            <stroke
                android:width="2dp"
                android:color="#D6D1A74C" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#E90A111B" />
            <stroke
                android:width="1dp"
                android:color="#A744D8FF" />
        </shape>
    </item>
</layer-list>
