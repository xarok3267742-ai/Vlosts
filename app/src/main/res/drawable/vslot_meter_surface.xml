<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:endColor="#F2070B12"
                android:startColor="#F5253343" />
            <stroke
                android:width="1dp"
                android:color="#E0D6AF55" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="#C909111C" />
            <stroke
                android:width="1dp"
                android:color="#7049D9FF" />
        </shape>
    </item>
</layer-list>
