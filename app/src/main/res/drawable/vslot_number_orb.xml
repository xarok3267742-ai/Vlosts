<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#D9050B1D" />
            <stroke
                android:width="2dp"
                android:color="#D4F3CC58" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:end="3dp"
        android:start="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:centerColor="#D51A1D4A"
                android:endColor="#DE07132C"
                android:startColor="#DB164663" />
            <stroke
                android:width="1dp"
                android:color="#C06EF0FF" />
        </shape>
    </item>
</layer-list>
