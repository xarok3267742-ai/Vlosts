<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#CC070D22" />
            <stroke
                android:width="2dp"
                android:color="#B8F8D96C" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:end="3dp"
        android:start="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="0"
                android:centerColor="#DC251153"
                android:endColor="#D708193A"
                android:startColor="#D10C3157" />
            <stroke
                android:width="1dp"
                android:color="#A87BEAFF" />
        </shape>
    </item>
</layer-list>
