<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:tag="dialog_preferred_width_430dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/autoSpinTitle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:contentDescription="@string/auto_spin_count_title"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:scaleType="fitCenter"
            android:src="@drawable/title_auto_spin" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/label_auto_spin_choose" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption10" />
            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption25" />
            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption50" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoSpinSafeguards"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/auto_spin_safeguards" />

        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:scaleType="fitXY"
                android:src="@drawable/btn_modal_close_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
