<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_modal_panel_premium" />

    <ImageView
        android:id="@+id/lowCoinsCautionStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_caution_stage" />

    <ImageView
        android:id="@+id/lowCoinsRescueGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_rescue_glow"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:minHeight="260dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:contentDescription="@null"
                android:src="@drawable/low_coins_badge" />

            <FrameLayout
                android:id="@+id/lowCoinsCooldownTimerRail"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/daily_bonus_cooldown_remaining"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/low_coins_cooldown_rail" />

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_daily_bonus_timer" />

                <com.vslot.app.ui.widget.BitmapNumberView
                    android:id="@+id/lowCoinsCooldownTimerDigits"
                    android:layout_width="94dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/lowCoinsTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/low_coins"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/title_low_coins" />

            <ImageView
                android:id="@+id/lowCoinsBody"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/low_coins_bonus_body"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_low_coins_bonus_body" />

            <TextView
                android:id="@+id/lowCoinsBodyLargeText"
                style="@style/VSlotAccessibleCopy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/low_coins_bonus_body"
                android:textAlignment="center"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/claim_bonus"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_bonus_claim_selector" />

                <ImageView
                    android:id="@+id/actionButtonLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_claim_bonus" />

                <TextView
                    android:id="@+id/actionButtonText"
                    style="@style/VSlotAccessibleCopy.Command.Compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/low_coins_reduce_action"
                    android:textAlignment="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
