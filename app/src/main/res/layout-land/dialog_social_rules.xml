<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp"
    android:tag="dialog_preferred_width_840dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/social_rules_modal_panel" />

    <ImageView
        android:id="@+id/socialRulesComplianceSeal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/social_rules_compliance_seal"
        android:visibility="invisible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="260dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/socialRulesHeaderColumn"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/socialRulesBadge"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/modal_badge_rules" />

            <ImageView
                android:id="@+id/socialRulesTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/social_casino_rules"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/title_social_rules" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/socialRulesHeaderColumn"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/socialRulesBody"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:contentDescription="@string/social_casino_rules_body"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/body_social_rules" />

            <TextView
                android:id="@+id/socialRulesBodyLargeText"
                style="@style/VSlotAccessibleCopy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/social_casino_rules_body"
                android:textAlignment="center"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/socialRulesFooter"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/social_casino_rules_footer"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_social_rules_footer" />

            <TextView
                android:id="@+id/socialRulesFooterLargeText"
                style="@style/VSlotAccessibleCopy.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/social_casino_rules_footer"
                android:textAlignment="center"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp">

                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/close"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_modal_close_selector" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_close" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
