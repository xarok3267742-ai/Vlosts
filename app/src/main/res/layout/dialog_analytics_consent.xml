<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/push_permission_modal_panel_premium" />

    <ImageView
        android:id="@+id/analyticsConsentSignal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/push_permission_signal_burst"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="478dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/analyticsConsentBadge"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/privacy_guard_badge" />

        <ImageView
            android:id="@+id/analyticsConsentTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/settings_analytics"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/title_analytics_consent" />

        <ImageView
            android:id="@+id/analyticsConsentBody"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/analytics_consent_body"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/body_analytics_consent" />

        <TextView
            android:id="@+id/analyticsConsentBodyLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/analytics_consent_body"
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/declineButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/analytics_decline"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_push_later_selector" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_analytics_decline" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/allowButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/analytics_allow"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_push_allow_selector" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_analytics_allow" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
