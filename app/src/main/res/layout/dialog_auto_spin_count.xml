<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="14dp"
        android:alpha="0.72"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/paytable_odds_header_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/autoSpinTitle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:contentDescription="@string/auto_spin_count_title"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:scaleType="fitCenter"
            android:src="@drawable/title_auto_spin" />

        <TextView
            android:id="@+id/autoSpinTitleLargeText"
            style="@style/VSlotAccessibleCopy.Command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/auto_spin_count_title"
            android:textAlignment="center"
            android:textSize="18sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/autoSpinChoose"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/label_auto_spin_choose" />

        <TextView
            android:id="@+id/autoSpinChooseLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/auto_spin_count_choose"
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption10" />
            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption25" />
            <include layout="@layout/item_auto_spin_count_option" android:id="@+id/autoSpinOption50" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoSpinSafeguards"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/auto_spin_safeguards" />

        <FrameLayout
            android:layout_width="154dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:scaleType="fitXY"
                android:src="@drawable/btn_modal_close_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
