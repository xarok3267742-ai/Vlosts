<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_modal_panel_premium" />

    <ImageView
        android:id="@+id/lowCoinsCautionStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_caution_stage" />

    <ImageView
        android:id="@+id/lowCoinsRescueGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/low_coins_rescue_glow"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="444dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="26dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:contentDescription="@null"
            android:src="@drawable/low_coins_badge" />

        <ImageView
            android:id="@+id/lowCoinsTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/low_coins"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/title_low_coins" />

        <ImageView
            android:id="@+id/lowCoinsBody"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/low_coins_bonus_body"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/label_low_coins_bonus_body" />

        <TextView
            android:id="@+id/lowCoinsBodyLargeText"
            style="@style/VSlotAccessibleCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/low_coins_bonus_body"
            android:textAlignment="center"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/lowCoinsCooldownTimerRail"
            android:layout_width="222dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/daily_bonus_cooldown_remaining"
            android:visibility="gone">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/low_coins_cooldown_rail" />

            <ImageView
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/label_daily_bonus_timer" />

            <com.vslot.app.ui.widget.BitmapNumberView
                android:id="@+id/lowCoinsCooldownTimerDigits"
                android:layout_width="126dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/actionButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/claim_bonus"
                android:scaleType="fitXY"
                android:src="@drawable/btn_bonus_claim_selector" />

            <ImageView
                android:id="@+id/actionButtonLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_claim_bonus" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
