<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:id="@+id/paytableModalPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/paytable_modal_panel_violet" />

    <ImageView
        android:id="@+id/paytableCabinetLattice"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/paytable_cabinet_lattice" />

    <ImageView
        android:id="@+id/paytableOddsHeaderGlow"
        android:layout_width="match_parent"
        android:layout_height="248dp"
        android:layout_marginTop="18dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/paytable_odds_header_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="620dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/paytableTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/title_paytable_violet_fortune" />

            <LinearLayout
                android:id="@+id/paytableBetsGroup"
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/paytableBetsLabel"
                    android:layout_width="92dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_bets" />

                <TextView
                    android:id="@+id/paytableBetsDigits"
                    style="@style/VSlotAccessibleCopy.PaytableValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/paytablePaylineGuide"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@string/paytable_payline_guide"
            android:importantForAccessibility="yes"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/paytable_payline_guide" />

        <TextView
            android:id="@+id/paytablePaylineGuideLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/paytable_payline_guide"
            android:textAlignment="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/paytableBetExplanation"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/paytable_bet_explanation"
            android:importantForAccessibility="yes"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/label_paytable_bet_explanation"
            android:visibility="gone" />

        <TextView
            android:id="@+id/paytableBetExplanationLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/paytable_bet_explanation"
            android:textAlignment="center"
            android:textSize="12sp"
            android:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:contentDescription="@string/paytable_symbol_header"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_symbol" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/paytableHeaderThree"
                    style="@style/VSlotAccessibleCopy.PaytableValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paytable_header_three"
                    android:textSize="15sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/paytableHeaderFour"
                    style="@style/VSlotAccessibleCopy.PaytableValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paytable_header_four"
                    android:textSize="15sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/paytableHeaderFive"
                    style="@style/VSlotAccessibleCopy.PaytableValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/paytable_header_five"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/paytableRowsStage"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="5dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ScrollView
                android:id="@+id/paytableScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:fadeScrollbars="false"
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/paytableRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <ImageView
                android:id="@+id/paytableScrollHint"
                android:layout_width="18dp"
                android:layout_height="78dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-6dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/paytable_scroll_hint" />
        </FrameLayout>

        <ImageView
            android:id="@+id/paytableFooter"
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:layout_marginTop="7dp"
            android:contentDescription="@string/paytable_footer_violet"
            android:importantForAccessibility="yes"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/label_paytable_footer_violet"
            android:visibility="gone" />

        <TextView
            android:id="@+id/paytableFooterLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/paytable_footer_violet"
            android:textAlignment="center"
            android:textSize="12sp"
            android:visibility="visible" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="7dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:scaleType="fitXY"
                android:src="@drawable/btn_modal_close_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
