<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/push_permission_modal_panel_premium" />

    <ImageView
        android:id="@+id/pushPromptPanelLattice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/push_prompt_panel_lattice" />

    <ImageView
        android:id="@+id/pushSignalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/push_permission_signal_burst"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="416dp"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="28dp"
        android:paddingEnd="30dp"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/pushPromptBadge"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/modal_badge_push" />

        <ImageView
            android:id="@+id/pushPromptTitle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/push_prompt_title"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/title_push_notifications" />

        <ImageView
            android:id="@+id/pushPromptBody"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/push_prompt_body"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/body_push_prompt" />

        <TextView
            android:id="@+id/pushPromptBodyLargeText"
            style="@style/VSlotAccessibleCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/push_prompt_body"
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/maybeLaterButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/maybe_later"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_push_later_selector" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_maybe_later" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/allowButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/allow"
                    android:scaleType="fitXY"
                    android:src="@drawable/btn_push_allow_selector" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/label_allow" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
