<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:id="@+id/resultModalPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/result_modal_panel_violet_premium" />

    <ImageView
        android:id="@+id/resultStageLattice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/result_stage_lattice" />

    <ImageView
        android:id="@+id/resultThemeWinBurst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/theme_win_burst_violet"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/resultRewardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/result_win_payout_burst"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/resultRewardSparkle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/result_reward_sparkle"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="472dp"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="28dp"
        android:paddingEnd="30dp"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/resultGlow"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@null"
            android:src="@drawable/modal_badge_win" />

        <ImageView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/title_win" />

        <LinearLayout
            android:id="@+id/winAmountGroup"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/coin_icon" />

            <com.vslot.app.ui.widget.BitmapNumberView
                android:id="@+id/winAmountDigits"
                android:layout_width="190dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/resultFreeSpinsAwardGroup"
            android:layout_width="264dp"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:visibility="gone">

            <ImageView
                android:id="@+id/resultFreeSpinsAwardPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/result_free_spins_award_panel" />

            <com.vslot.app.ui.widget.BitmapNumberView
                android:id="@+id/resultFreeSpinsAwardDigits"
                android:layout_width="58dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="51dp"
                android:importantForAccessibility="no"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </FrameLayout>

        <ImageView
            android:id="@+id/resultBody"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/result_win_body"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/label_result_win_body" />

        <TextView
            android:id="@+id/resultBodyLargeText"
            style="@style/VSlotAccessibleCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/result_win_body"
            android:textAlignment="center"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:scaleType="fitXY"
                android:src="@drawable/btn_modal_close_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
