<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/modal_panel_backplate" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/social_rules_modal_panel" />

    <ImageView
        android:id="@+id/socialRulesComplianceSeal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/social_rules_compliance_seal"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="556dp"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/socialRulesBadge"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/modal_badge_rules" />

        <ImageView
            android:id="@+id/socialRulesTitle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/social_casino_rules"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/title_social_rules" />

        <ImageView
            android:id="@+id/socialRulesBody"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/social_casino_rules_body"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/body_social_rules" />

        <TextView
            android:id="@+id/socialRulesBodyLargeText"
            style="@style/VSlotAccessibleCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/social_casino_rules_body"
            android:textAlignment="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/socialRulesFooter"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/social_casino_rules_footer"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/label_social_rules_footer" />

        <TextView
            android:id="@+id/socialRulesFooterLargeText"
            style="@style/VSlotAccessibleCopy.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/social_casino_rules_footer"
            android:textAlignment="center"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:scaleType="fitXY"
                android:src="@drawable/btn_modal_close_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/label_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
