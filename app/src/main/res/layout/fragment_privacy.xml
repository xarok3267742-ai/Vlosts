<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/main_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/privacyTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/top_bar_premium" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:src="@drawable/btn_back_selector" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/title_privacy_policy" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/privacy_web_panel_premium" />

            <ImageView
                android:id="@+id/privacyGuardDocumentGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp"
                android:alpha="0"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/privacy_guard_document_glow"
                android:visibility="invisible" />

            <WebView
                android:id="@+id/privacyWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp"
                android:background="@color/input_dark" />

            <FrameLayout
                android:id="@+id/privacyLoadingGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/privacy_loading"
                android:importantForAccessibility="yes"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/privacyLoadingSweep"
                    android:layout_width="260dp"
                    android:layout_height="360dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/privacy_loading_sweep"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/privacyLoadingShield"
                    android:layout_width="248dp"
                    android:layout_height="248dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/privacy_loading_shield" />

                <ImageView
                    android:id="@+id/privacyLoadingScanRail"
                    android:layout_width="220dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="94dp"
                    android:alpha="0.74"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/privacy_loading_scan_rail" />
            </FrameLayout>

            <ScrollView
                android:id="@+id/errorGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:id="@+id/privacyGuardBadge"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:contentDescription="@null"
                        android:src="@drawable/privacy_guard_badge" />

                    <ImageView
                        android:id="@+id/errorImage"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="18dp"
                        android:contentDescription="@string/privacy_load_error"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/label_privacy_error_load" />

                    <FrameLayout
                        android:id="@+id/retryButtonGroup"
                        android:layout_width="180dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp">

                        <ImageButton
                            android:id="@+id/retryButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/retry"
                            android:scaleType="fitXY"
                            android:src="@drawable/btn_privacy_retry_selector" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/label_retry" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
