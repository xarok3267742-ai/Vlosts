<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/main_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/top_bar_premium" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:scaleType="fitCenter"
                android:src="@drawable/btn_back_selector" />

            <ImageView
                android:id="@+id/settingsTitleImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/settings"
                android:paddingStart="72dp"
                android:paddingEnd="72dp"
                android:scaleType="fitCenter"
                android:src="@drawable/title_settings" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/settings_modal_backplate" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/settings_modal_panel_premium" />

            <ImageView
                android:id="@+id/settingsControlGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/settings_control_console_glow"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/settingsCenterOrnament"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="174dp"
                android:alpha="0.72"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/settings_center_ornament" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/settingsScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="14dp">

                        <ImageView
                            android:id="@+id/settingsBadge"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="@null"
                            android:src="@drawable/modal_badge_settings" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:minHeight="32dp">

                            <ImageView
                                android:id="@+id/versionImage"
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/app_name"
                                android:paddingStart="32dp"
                                android:paddingEnd="32dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/label_version_current" />

                            <TextView
                                android:id="@+id/versionLargeText"
                                style="@style/VSlotAccessibleCopy.Compact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:text="@string/app_name"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="44dp">

                            <ImageView
                                android:id="@+id/socialDisclaimerImage"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/social_disclaimer_short"
                                android:scaleType="fitCenter"
                                android:src="@drawable/label_social_disclaimer_short" />

                            <TextView
                                android:id="@+id/socialDisclaimerLargeText"
                                style="@style/VSlotAccessibleCopy.Compact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="6dp"
                                android:text="@string/social_disclaimer_short"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/settingsFeedbackControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/soundToggleButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_privacy_selector"
                                android:clickable="true"
                                android:contentDescription="@string/settings_sound"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:importantForAccessibility="yes"
                                android:minHeight="56dp"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="6dp">

                                    <ImageView
                                        android:id="@+id/soundToggleIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:contentDescription="@null"
                                        android:duplicateParentState="true"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/settings_sound_selector" />

                                    <TextView
                                        android:id="@+id/soundToggleLabel"
                                        style="@style/VSlotAccessibleCopy.Command.Compact"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_sound" />

                                    <TextView
                                        android:id="@+id/soundToggleState"
                                        style="@style/VSlotAccessibleCopy.Compact"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:gravity="end|center_vertical"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_state_off" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/analyticsToggleButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/btn_privacy_selector"
                                android:clickable="true"
                                android:contentDescription="@string/settings_analytics"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:importantForAccessibility="yes"
                                android:minHeight="56dp"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="6dp">

                                    <ImageView
                                        android:id="@+id/analyticsToggleIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:contentDescription="@null"
                                        android:duplicateParentState="true"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/settings_analytics_selector" />

                                    <TextView
                                        android:id="@+id/analyticsToggleLabel"
                                        style="@style/VSlotAccessibleCopy.Command.Compact"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_analytics" />

                                    <TextView
                                        android:id="@+id/analyticsToggleState"
                                        style="@style/VSlotAccessibleCopy.Compact"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:gravity="end|center_vertical"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_state_off" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/hapticsToggleButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/btn_privacy_selector"
                                android:clickable="true"
                                android:contentDescription="@string/settings_haptics"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:importantForAccessibility="yes"
                                android:minHeight="56dp"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="6dp">

                                    <ImageView
                                        android:id="@+id/hapticsToggleIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:contentDescription="@null"
                                        android:duplicateParentState="true"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/settings_haptics_selector" />

                                    <TextView
                                        android:id="@+id/hapticsToggleLabel"
                                        style="@style/VSlotAccessibleCopy.Command.Compact"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_haptics" />

                                    <TextView
                                        android:id="@+id/hapticsToggleState"
                                        style="@style/VSlotAccessibleCopy.Compact"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:gravity="end|center_vertical"
                                        android:importantForAccessibility="no"
                                        android:text="@string/settings_state_off" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/settingsLegalActionsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="false"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/privacyActionContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp">

                                <ImageButton
                                    android:id="@+id/privacyButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="@string/privacy_policy"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/btn_privacy_selector" />

                                <ImageView
                                    android:id="@+id/privacyButtonLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="14dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/label_privacy_policy" />

                                <TextView
                                    android:id="@+id/privacyButtonLargeText"
                                    style="@style/VSlotAccessibleCopy.Command.Compact"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:minHeight="60dp"
                                    android:paddingStart="14dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="8dp"
                                    android:text="@string/privacy_policy"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/noticesActionContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:minHeight="60dp">

                                <ImageButton
                                    android:id="@+id/noticesButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="@string/third_party_notices_action"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/btn_privacy_selector" />

                                <ImageView
                                    android:id="@+id/noticesButtonLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="14dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/label_third_party_notices" />

                                <TextView
                                    android:id="@+id/noticesButtonLargeText"
                                    style="@style/VSlotAccessibleCopy.Command.Compact"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:minHeight="60dp"
                                    android:paddingStart="14dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="8dp"
                                    android:text="@string/third_party_notices_action"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="56dp">

                            <ImageButton
                                android:id="@+id/rulesButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/social_casino_rules"
                                android:scaleType="fitXY"
                                android:src="@drawable/btn_privacy_selector" />

                            <ImageView
                                android:id="@+id/rulesButtonLabel"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:paddingStart="24dp"
                                android:paddingEnd="24dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/label_social_rules" />

                            <TextView
                                android:id="@+id/rulesButtonLargeText"
                                style="@style/VSlotAccessibleCopy.Command"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:minHeight="56dp"
                                android:paddingStart="14dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="8dp"
                                android:text="@string/social_casino_rules"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/pushActionStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="56dp"
                            android:visibility="gone">

                            <ImageButton
                                android:id="@+id/pushButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/push_prompt_title"
                                android:scaleType="fitXY"
                                android:src="@drawable/btn_privacy_selector" />

                            <ImageView
                                android:id="@+id/pushButtonLabel"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:paddingStart="24dp"
                                android:paddingEnd="24dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/label_push_reminders" />

                            <TextView
                                android:id="@+id/pushButtonLargeText"
                                style="@style/VSlotAccessibleCopy.Command"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:minHeight="56dp"
                                android:paddingStart="14dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="8dp"
                                android:text="@string/push_reminders_action"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/pushStatusStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:contentDescription="@string/push_not_enabled_status"
                            android:importantForAccessibility="yes"
                            android:minHeight="56dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/pushStatusConsole"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitXY"
                                android:src="@drawable/settings_push_status_console" />

                            <ImageView
                                android:id="@+id/pushStatusSignalPulse"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="9dp"
                                android:alpha="0.66"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:src="@drawable/settings_push_status_signal_pulse" />

                            <ImageView
                                android:id="@+id/pushStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:paddingStart="62dp"
                                android:paddingEnd="18dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/label_push_status_off" />

                            <TextView
                                android:id="@+id/pushStatusLargeText"
                                style="@style/VSlotAccessibleCopy.Command"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:minHeight="56dp"
                                android:paddingStart="62dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="8dp"
                                android:text="@string/push_not_enabled_status"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </ScrollView>

                <FrameLayout
                    android:id="@+id/settingsSafetyStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:minHeight="118dp">

                    <ImageView
                        android:id="@+id/settingsSafetyAnchor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        android:alpha="0.86"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/settings_safety_anchor" />

                    <ImageView
                        android:id="@+id/settingsSafetyPanel"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="6dp"
                        android:contentDescription="@string/settings_safety_panel"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/settings_safety_panel"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/settingsSafetyLargeText"
                        style="@style/VSlotAccessibleCopy.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/vslot_text_capsule"
                        android:gravity="center"
                        android:minHeight="112dp"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="@string/settings_safety_panel"
                        android:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
