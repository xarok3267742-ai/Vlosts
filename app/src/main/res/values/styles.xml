<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VSlot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/deep_navy</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorAccent">@color/primary_red</item>
        <item name="android:navigationBarColor">@color/deep_navy</item>
        <item name="android:statusBarColor">@color/deep_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.VSlot.Launcher" parent="Theme.VSlot" />

    <style name="VSlotAccessibleCopy">
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:hyphenationFrequency">full</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/accessible_copy_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VSlotAccessibleCopy.Compact">
        <item name="android:textColor">@color/accessible_copy_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="VSlotAccessibleCopy.Command" parent="VSlotAccessibleCopy">
        <item name="android:breakStrategy">balanced</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:shadowColor">#FF000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:textColor">@color/accessible_copy_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VSlotAccessibleCopy.Command.Compact" parent="VSlotAccessibleCopy.Command">
        <item name="android:textSize">13sp</item>
    </style>
</resources>
